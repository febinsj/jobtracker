// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  previewFeatures = ["fullTextSearch"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  firstName String?
  lastName  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  jobs       Job[]
  shares     Share[]  @relation("OwnerShares")
  sharedWith Share[]  @relation("ViewerShares")

  @@index([email])
}

model Job {
  id          String   @id @default(cuid())
  userId      String
  company     String
  title       String
  location    String?
  jobLink     String?
  salaryMin   Float?
  salaryMax   Float?
  source      String?
  interest    Int      @default(5) // 1-10 scale
  description String?  @db.Text // Full pasted JD text
  descPreview String?  // Auto-generated: first 100 chars
  notes       String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  applications Application[]

  @@index([userId])
  @@index([company])
  @@index([createdAt])
}

model Application {
  id             String    @id @default(cuid())
  jobId          String
  status         Status    @default(SAVED)
  stage          Stage?
  dateApplied    DateTime?
  dateSaved      DateTime  @default(now())
  deadline       DateTime?
  lastActivityAt DateTime  @updatedAt
  nextFollowupAt DateTime?
  outcome        String?
  outcomeNotes   String?   @db.Text

  job        Job         @relation(fields: [jobId], references: [id], onDelete: Cascade)
  interviews Interview[]
  contacts   Contact[]

  @@unique([jobId])
  @@index([status])
  @@index([nextFollowupAt])
  @@index([deadline])
}

model Contact {
  id            String  @id @default(cuid())
  applicationId String
  name          String
  role          String?
  email         String?
  phone         String?
  linkedin      String?
  notes         String? @db.Text

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
}

model Interview {
  id            String    @id @default(cuid())
  applicationId String
  type          String // "Phone Screen", "Technical", "Onsite", "Final"
  scheduledAt   DateTime
  duration      Int? // minutes
  location      String? // "Remote", "Office", address
  interviewer   String?
  notes         String?   @db.Text
  outcome       String? // "Passed", "Failed", "Pending"
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@index([scheduledAt])
}

model Share {
  id        String   @id @default(cuid())
  token     String   @unique @default(cuid())
  ownerId   String
  viewerId  String?
  expiresAt DateTime?
  createdAt DateTime @default(now())

  owner  User  @relation("OwnerShares", fields: [ownerId], references: [id], onDelete: Cascade)
  viewer User? @relation("ViewerShares", fields: [viewerId], references: [id])

  @@index([token])
  @@index([ownerId])
}

enum Status {
  BACKLOG
  SAVED
  TO_APPLY
  APPLIED
  ASSESSMENT
  INTERVIEW
  OFFER
  REJECTED
  WITHDRAWN
}

enum Stage {
  SCREENING
  TECHNICAL
  ONSITE
  FINAL
}